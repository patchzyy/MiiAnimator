<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MiiAnimator</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
        <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
        <PackageReference Include="Svg.Skia" Version="5.1.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Built-in particle images, loaded by BuiltInShapes as "ParticleShapes/Puff.svg" etc. -->
        <EmbeddedResource Include="Assets\ParticleShapes\*.svg" LogicalName="ParticleShapes/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="MiiAnimator.MiiData" />
        <Using Static="true" Include="MiiAnimator.MiiData.OperationError" />
        <Using Static="true" Include="MiiAnimator.MiiData.OperationResult" />
        <ProjectReference Include="..\MiiAnim.Core\MiiAnim.Core.csproj" />
    </ItemGroup>
</Project>
